{
  "expo": {
    "name": "Justif.ai",
    "slug": "justifai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand-icon.png",
    "scheme": "justifai",
    "jsEngine": "hermes",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.justifai.app.v2",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Justif.ai to use your camera to take photos of legal documents.",
        "NSPhotoLibraryUsageDescription": "Allow Justif.ai to access your photo library to upload legal documents and profile pictures."
      }
    },
    "android": {
      "package": "com.justifai.app.v2",
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#171717",
        "foregroundImage": "./assets/brand-adaptive.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "versionCode": 9
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand-favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Justif.ai to access your photos to analyze legal documents.",
          "cameraPermission": "Allow Justif.ai to take photos of legal documents."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand-splash.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#171717"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f754c01b-5b19-46ed-9cdf-d477e7714cbe"
      }
    },
    "owner": "roentgen"
  }
}
