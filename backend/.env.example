# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# DeepSeek API (LLM Service)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Groq API (Optional / Legacy)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=qwen/qwen3.8-27b

# Pinecone (Vector Database for RAG)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=justifai-laws

# Embeddings: run the quantized open model on the backend, without API fees.
EMBEDDING_PROVIDER=fastembed
FASTEMBED_CACHE_PATH=.cache/fastembed
# Optional paid provider: set EMBEDDING_PROVIDER=nomic explicitly.
NOMIC_API_KEY=your-nomic-api-key

# Optional laptop-hosted Ollama: set EMBEDDING_PROVIDER=local.
OLLAMA_BASE_URL=http://localhost:11434

# Vision Service for Document Image Uploads (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_VISION_MODEL=gemini-3.8-flash
# Use the vision-capable DeepSeek model first; Gemini remains a fallback.
DOCUMENT_OCR_PRIMARY=deepseek

# CORS (comma-separated origins — do NOT use * in production)
CORS_ORIGINS=https://your-app.onrender.com,http://localhost:8000,http://localhost:19006

# Server
HOST=0.0.0.0
PORT=8000

# Security
DEBUG=true
RATE_LIMIT=30/minute
