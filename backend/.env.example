# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# DeepSeek API (LLM Service)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Groq API (Optional / Legacy)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=qwen/qwen3.8-27b

# Pinecone (Vector Database for RAG)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=justifai-laws

# Ollama (Local Embedding Server)
# Embeddings: Nomic Cloud API (for Render / Cloud deployment)
NOMIC_API_KEY=your-nomic-api-key

# Ollama (Local Embedding Server fallback)
OLLAMA_BASE_URL=http://localhost:11434

# Vision Service for Document Image Uploads (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_VISION_MODEL=gemini-2.0-flash

# CORS (comma-separated origins — do NOT use * in production)
CORS_ORIGINS=https://your-app.onrender.com,http://localhost:8000,http://localhost:19006

# Server
HOST=0.0.0.0
PORT=8000

# Security
DEBUG=true
RATE_LIMIT=30/minute
